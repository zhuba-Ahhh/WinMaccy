<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#5B8CFF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202127" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#26282F" />
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#2E3139" />
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#2E406E" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEEF2" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA1AE" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#353841" />
    <SolidColorBrush x:Key="PinnedBadgeBrush" Color="#F5B84D" />
</ResourceDictionary>
