# Auto detect text files and let Git normalize line endings
* text=auto

# Source files: always LF in the repo
*.cs   text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.sln  text eol=crlf
*.manifest text eol=crlf
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.md   text eol=lf

# Binary assets
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
