<Window x:Class="WinMaccy.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WinMaccy.Converters"
        xmlns:ui="clr-namespace:WinMaccy.UI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Width="720"
        SizeToContent="Height"
        MinHeight="140"
        MaxHeight="640"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <conv:KindGlyphConverter x:Key="KindGlyph" />
        <conv:MetaConverter x:Key="Meta" />
        <conv:ThumbnailConverter x:Key="Thumb" />
        <conv:AppIconConverter x:Key="AppIcon" />
        <conv:BadgeVisibilityConverter x:Key="BadgeVis" />
        <conv:BadgeShowConverter x:Key="BadgeShow" />
        <conv:BadgeTextConverter x:Key="BadgeText" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <!-- Row hover action icon button (pin / delete) -->
        <Style x:Key="RowIconButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Margin="6,1"
                                Background="Transparent" Padding="10,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="12" Background="{DynamicResource WindowBackgroundBrush}"
            BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search bar (rounded pill like Maccy) -->
            <Border Grid.Row="0" Margin="12,12,12,8" CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                <Grid Margin="10,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="15" VerticalAlignment="Center" Padding="0"
                             TextChanged="SearchBox_TextChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Results -->
            <Grid Grid.Row="1">
                <ListBox x:Name="ResultsList" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource PopupListItem}"
                         AlternationCount="100"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseLeftButtonUp="ResultsList_MouseLeftButtonUp">
                    <ListBox.Resources>
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="8" />
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="46">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- thumbnail, source app icon, or kind glyph -->
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="7"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Grid>
                                        <TextBlock Text="{Binding Converter={StaticResource KindGlyph}}"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="15" Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Converter={StaticResource AppIcon}}"
                                               Width="22" Height="22" Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Converter={StaticResource Thumb}}"
                                               Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,34,34" RadiusX="7" RadiusY="7" />
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                </Border>

                                <!-- texts -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                                    <ui:HighlightTextBlock SourceText="{Binding Preview}"
                                                           Query="{Binding Text, ElementName=SearchBox}"
                                                           FontSize="13.5"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="20" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="&#xE718;" FontSize="10"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource PinnedBadgeBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Converter={StaticResource Meta}}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- right side: hover actions + quick-select badge -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource RowIconButton}" Content="&#xE718;"
                                            ToolTip="固定 / 取消固定 (Alt+P)"
                                            Click="RowPin_Click"
                                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                                Path=IsMouseOver, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource RowIconButton}" Content="&#xE74D;"
                                            ToolTip="删除 (Del)"
                                            Click="RowDelete_Click"
                                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                                Path=IsMouseOver, Converter={StaticResource BoolToVis}}" />
                                    <Border Width="24" Height="18" CornerRadius="4" Margin="2,0,0,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                                        <Border.Visibility>
                                            <MultiBinding Converter="{StaticResource BadgeShow}">
                                                <Binding RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=ListBoxItem}"
                                                         Path="IsMouseOver" />
                                            </MultiBinding>
                                        </Border.Visibility>
                                        <TextBlock FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                                Converter={StaticResource BadgeText}}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- empty state -->
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed" Margin="0,26">
                    <TextBlock Text="&#xE8C8;" FontSize="30" TextAlignment="Center"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="EmptyText" Text="暂无历史记录" Margin="0,10,0,0"
                               FontSize="13" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- footer hints -->
            <Border x:Name="FooterBorder" Grid.Row="2" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="14,7">
                <WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Enter 粘贴" />
                    <TextBlock Style="{StaticResource Hint}" Text="Shift+Enter 仅复制" />
                    <TextBlock Style="{StaticResource Hint}" Text="Ctrl+Enter 纯文本" />
                    <TextBlock Style="{StaticResource Hint}" Text="Alt+P 固定" />
                    <TextBlock Style="{StaticResource Hint}" Text="Del 删除" />
                    <TextBlock Style="{StaticResource Hint}" Text="Ctrl+Shift+Del 清空" />
                    <TextBlock Style="{StaticResource Hint}" Text="Ctrl+1..9 快选" />
                    <TextBlock Style="{StaticResource Hint}" Text="Esc 关闭" />
                </WrapPanel>
            </Border>
        </Grid>
    </Border>
</Window>
