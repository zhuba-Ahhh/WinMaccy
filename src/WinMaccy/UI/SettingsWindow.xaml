<Window x:Class="WinMaccy.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinMaccy 设置"
        Icon="/Assets/app.ico"
        Width="560" Height="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        ResizeMode="CanMinimize"
        UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>

                <!-- General -->
                <TextBlock Text="常规" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,0,0,10" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="ChkAutoPaste" Content="选中后自动粘贴（关闭时仅复制到剪贴板）"
                                  Style="{StaticResource SettingCheck}" />
                        <CheckBox x:Name="ChkStartWithWindows" Content="开机时自动启动 WinMaccy"
                                  Style="{StaticResource SettingCheck}" />
                        <CheckBox x:Name="ChkShowFooter" Content="在弹窗底部显示快捷键提示"
                                  Style="{StaticResource SettingCheck}" />
                        <Grid Margin="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="外观主题" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="140" SelectedIndex="0">
                                <ComboBoxItem Content="跟随系统" />
                                <ComboBoxItem Content="浅色" />
                                <ComboBoxItem Content="深色" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hotkey -->
                <TextBlock Text="快捷键" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,18,0,10" />
                <Border Style="{StaticResource Card}">
                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="唤起剪贴板历史" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="需要至少一个修饰键（Ctrl / Alt / Shift / Win）"
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button x:Name="HotKeyButton" Grid.Column="1" Height="32"
                                HorizontalAlignment="Stretch" Click="HotKeyButton_Click"
                                Content="Ctrl + Shift + C" />
                    </Grid>
                </Border>

                <!-- History -->
                <TextBlock Text="历史记录" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,18,0,10" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="ChkCaptureImages" Content="记录图片" Style="{StaticResource SettingCheck}" />
                        <CheckBox x:Name="ChkCaptureFiles" Content="记录复制的文件" Style="{StaticResource SettingCheck}" />
                        <Grid Margin="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最多保留条数（置顶项不受限）" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBox x:Name="MaxItemsBox" Grid.Column="1" Height="28"
                                     VerticalContentAlignment="Center" Padding="6,0" />
                        </Grid>
                        <Grid Margin="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="单张图片大小上限（MB）" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBox x:Name="MaxImageBox" Grid.Column="1" Height="28"
                                     VerticalContentAlignment="Center" Padding="6,0" />
                        </Grid>
                        <Grid Margin="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="清空历史" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Button x:Name="ClearButton" Grid.Column="1" Content="清空（保留置顶）"
                                    Width="120" Height="30" Margin="0,0,8,0" Click="ClearButton_Click" />
                            <Button x:Name="ClearAllButton" Grid.Column="2" Content="全部清空"
                                    Width="90" Height="30" Click="ClearAllButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Privacy -->
                <TextBlock Text="隐私" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,18,0,10" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Margin="12,10">
                        <TextBlock Text="忽略以下程序的复制（进程名，逗号分隔，如：1Password, keepass）"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox x:Name="IgnoredAppsBox" Margin="0,8,0,0" Height="64"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Padding="6,4" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Width="90" Height="32" Margin="0,0,10,0" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Content="保存" Width="90" Height="32" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
