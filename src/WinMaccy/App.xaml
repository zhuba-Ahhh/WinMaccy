<Application x:Class="WinMaccy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Card container used by the settings window -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                <Setter Property="Padding" Value="4,6" />
            </Style>

            <Style x:Key="SettingCheck" TargetType="CheckBox">
                <Setter Property="Margin" Value="12,8" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- Default icon for all standard windows (popup is borderless). -->
            <Style TargetType="Window">
                <Setter Property="Icon" Value="Assets/app.ico" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
